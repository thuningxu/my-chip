# TEMPLATE -- scripts/measure.sh substitutes the period placeholder and writes the result to
# work/designs/nangate45/<nick>/constraint.sdc.
#
# Edit THIS file, not the generated copy.
#
# Convention: single clock, 20%-of-period I/O delays, 0.1 ns clock uncertainty,
# false path on the async rst_n.
#
# The clock uncertainty is NOT optional. It budgets for jitter and skew that a
# real clock has and an ideal SDC does not. A prior project of this kind omitted
# it, which flattered every frequency it reported by roughly 10%.
set clk_period @PERIOD@

create_clock -name core_clock -period $clk_period [get_ports clk]

# Exclude the clock port itself from input delay -- applying set_input_delay to
# a clock port is meaningless and OpenSTA warns about it.
set non_clock_inputs [lsearch -inline -all -not -exact [all_inputs] [get_ports clk]]
set_input_delay  [expr $clk_period * 0.2] -clock core_clock $non_clock_inputs
set_output_delay [expr $clk_period * 0.2] -clock core_clock [all_outputs]

set_clock_uncertainty 0.1 [get_clocks core_clock]

# rst_n is asynchronous; its recovery/removal path is not a functional path.
set_false_path -from [get_ports rst_n]
